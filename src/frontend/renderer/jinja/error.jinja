<!DOCTYPE html>
<html lang="en">
{% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="{{ server.icon_url }}">
    <title>{{ error.summary or "Error" }} | {{ server.name or "Pageshelf" }}</title>

    <!-- SEO, Metadata -->
    <meta name="description" content="{{ server.about }}">
    <meta name="theme-color" content="#40e0d0" data-react-helmet="true"/>
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta name="og:site_name" content="{{ server.name }}">
    <meta property="og:title" content="{{ server.name }}">
    <meta property="og:description" content="{{ server.about }}">
    <meta property="og:image" content="{{ server.icon_url }}">
    <meta property="og:url" content="{{ server.url }}">

    <!-- Twitter Cards -->
    <!-- 
    NOTE: Other services can use these, not just Twitter.
    If it was just Twitter, I probably wouldn't have this.
    -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ server.name }}">
    <meta name="twitter:image" content="{{ server.icon_url }}">
    <meta name="twitter:description" content="">
{% endblock %}

<!-- Styles -->
<style type="text/css">
    {% include "styles.css" %}
</style>

{% block body %}
    <!-- 
        Other fields should include:
        - error.note, contains extra information (either string, string array, or none/undefined)
        - error.suggestion, contains information to aid user/operator (either string, string array, or none/undefined)
    -->
    <!-- TODO: Visual improvements -->
        <header role="banner">
        {% include "header.html" %}
    </header>

    <main role="main" class="error-container">
        <section class="error-content" aria-labelledby="error-heading">
            <h1 id="error-heading" class="error-title">
                <span class="error-code">{{ error.code or 'Error' }}</span> 
                {{ error.summary or 'An unexpected error occurred' }}
            </h1>

            <p class="error-details">
                {{ error.details or 'No additional details provided.' }}
            </p>

            {% if error.notes %}
                <div class="error-note">
                    <h2>Notes</h2>
                    {% if error.notes is string %}
                        <p>{{ error.notes }}</p>
                    {% else %}
                        <ul>
                            {% for note in error.notes %}
                                <li>{{ note }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}

            {% if error.suggestions %}
                <div class="error-suggestion">
                    <h2>Suggestions</h2>
                    {% if error.suggestions is string %}
                        <p>{{ error.suggestions }}</p>
                    {% else %}
                        <ul>
                            {% for tip in error.suggestions %}
                                <li>{{ tip }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </main>

    <footer role="contentinfo">
        {% include "footer.html" %}
    </footer>
{% endblock %}
</html>